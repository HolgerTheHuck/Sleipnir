<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0 is a documented exception to the repo's net8.0-only rule:
         this core is shared with the Roslyn source generator, which must target
         netstandard2.0 so it loads inside the C# compiler host (and cannot
         reference the net8.0 SleipnirCore). The emission logic is self-contained:
         it parses the discovery JSON contract and emits C# text, with no Sleipnir
         dependency. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PackageId>Sleipnir.Codegen.Core</PackageId>
    <IsPackable>false</IsPackable>
    <Description>Discovery-driven C# client emitter core, shared by the Roslyn source generator and the server-side export/drift-check tool</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>