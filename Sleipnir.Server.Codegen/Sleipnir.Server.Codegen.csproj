<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- The tool reflects the consumer's BUILT server assembly via Assembly.LoadFrom. It must run on
         the consumer's runtime, not the net8 it was built against: a net8-pinned tool process cannot
         load/reflect a net10 (or net9) server assembly's controller types, so discovery silently
         returns an EMPTY contract (`{"controllers":[],"types":{}}`) — and the drift-check then passes
         vacuously (empty == empty). LatestMajor rolls `dotnet <tool.dll>` up to the highest installed
         runtime (net10 on a .NET 10 consumer), under which the net10 server assembly's types load and
         the [SleipnirController] scan succeeds. Safe for net8 consumers too: net8 is the highest
         installed runtime there, so it stays on net8. (Repro: a net10 server + the 1.1.2 package
         produced an empty contract; with LatestMajor the Orders controller + Repro10.Order type appear.) -->
    <RollForward>LatestMajor</RollForward>
    <PackageId>Sleipnir.Server.Codegen</PackageId>
    <IsPackable>true</IsPackable>
    <Description>Server-side Sleipnir contract export + drift-check. Regenerates the discovery contract (contract.sleipnir.json) in-process from a built server assembly via SleipnirDiscoveryService, and fails the build if the regenerated contract drifts from the committed one (SLEIPNIR_REGEN_GOLDEN=1 to regenerate). NuGet-shipped, Node-free.</Description>
    <AssemblyName>Sleipnir.Server.Codegen</AssemblyName>
    <RootNamespace>Sleipnir.Server.Codegen</RootNamespace>
    <!-- Tool, not a library: do not place the build output in lib/. It is shipped (with its deps) in
         tasks/net8.0/ below so the packaged build/*.targets can invoke it via `dotnet`. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- Tool package: the build output ships in tasks/net8.0/ (not lib/), so the "no lib
         assembly" and "deps not referenced" pack warnings are expected and intentional. -->
    <NoWarn>NU5100;NU5128</NoWarn>
    <!-- Tool package: IncludeBuildOutput=false ships the assembly in tasks/net8.0/ via <None>,
         so the SDK's snupkg has no .pdb and nuget.org rejects it (400 "no symbol files").
         Disable symbol packaging here — the 9 library packages still ship snupkgs. -->
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SleipnirCore\SleipnirCore.csproj" />
    <ProjectReference Include="..\SleipnirCommon\SleipnirCommon.csproj" />
  </ItemGroup>

  <!-- Pack the build/ targets into the nupkg so PackageReference auto-imports them. -->
  <ItemGroup>
    <None Include="build\**\*" Pack="true" PackagePath="build\" />
    <None Include="README.md" Pack="true" PackagePath="README.md" />
    <None Include="..\CODEGEN_ONBOARDING.md" Pack="true" PackagePath="docs/CODEGEN_ONBOARDING.md" />
  </ItemGroup>

  <!-- Ship the export tool as a COMPLETE, self-resolving framework-dependent app in tasks/net8.0/,
       so the packaged build/Sleipnir.Server.Codegen.targets can invoke
       `dotnet tasks/net8.0/Sleipnir.Server.Codegen.dll` and the isolated tool process resolves every
       dependency from that folder: no probing of the MSBuild host's paths or the consumer's NuGet cache.

       Why `dotnet publish` and not a glob over $(OutputPath):
         * IncludeBuildOutput=false (above) detaches Build from Pack, so at pack time $(OutputPath) is
           not populated by Pack itself.
         * Even when built, `dotnet build` of a framework-dependent Exe does NOT copy PackageReference
           assemblies (Microsoft.Extensions.*, JsonPath.Net, ...) into the output; they resolve from the
           NuGet cache at runtime. A `$(OutputPath)\*.dll` glob therefore packs at most the project's
           own + ProjectReference dlls, never the transitive closure.
         * The 1.1.1 package shipped only the tool dll + deps.json + runtimeconfig, so the tool crashed
           on the consumer's build with FileNotFoundException (Microsoft.Extensions.DependencyInjection.Abstractions),
           breaking every `dotnet build`/`run` of a server project that had the PackageReference plus
           a contract.sleipnir.json.
       `dotnet publish` (framework-dependent) copies the FULL dependency closure co-located and rewrites
       deps.json so `dotnet <tool>.dll` self-resolves. The consumer supplies the net8 runtime (it is
       building a net8 project anyway). -->
  <!-- BeforeTargets=_GetPackageFiles: the SDK collects the package file list in the _GetPackageFiles
       target (a dependency of GenerateNuspec; GetPackageContents does not exist in this SDK and would
       be silently ignored). Adding the None items only before GenerateNuspec is too late — they must
       exist when _GetPackageFiles evaluates. -->
  <Target Name="PublishExportToolForPack" BeforeTargets="_GetPackageFiles">
    <PropertyGroup>
      <_ToolPublishDir>$(MSBuildProjectDirectory)\obj\$(Configuration)\publish-tool</_ToolPublishDir>
    </PropertyGroup>
    <!-- Clean staging so a stale publish (e.g. after a dep is removed) never leaks into the nupkg. -->
    <RemoveDir Directories="$(_ToolPublishDir)" />
    <Exec Command="dotnet publish &quot;$(MSBuildProjectFullPath)&quot; -c $(Configuration) -o &quot;$(_ToolPublishDir)&quot; --no-self-contained" />
    <ItemGroup>
      <!-- The whole published app (flat deps + any runtimes/<rid>/native/* for native libs).
           Exclude apphost exes (the target invokes the .dll via `dotnet`, not the .exe, and an
           apphost is RID-specific), pdbs, and doc xml. -->
      <None Include="$(_ToolPublishDir)\**\*"
            Exclude="$(_ToolPublishDir)\**\*.pdb;$(_ToolPublishDir)\**\*.exe;$(_ToolPublishDir)\**\*.xml"
            Pack="true" PackagePath="tasks\net8.0\" />
    </ItemGroup>
  </Target>

</Project>