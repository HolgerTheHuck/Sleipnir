<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!-- CS0436 (duplicate generated types): customer.proto is generated twice — here as a
         gRPC client and, in parallel, as a gRPC server inside the referenced Sleipnir project.
         Both emit the same message types in the same namespace. This project is not packed and
         the duplicate is intentional (client + server sides of the same contract), so the
         type-conflict warning is noise (~215 of the solution's 460 full-rebuild warnings). -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.67.0" />
    <PackageReference Include="Grpc.Tools" Version="2.70.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sleipnir\Sleipnir.csproj" />
    <ProjectReference Include="..\SleipnirClient\SleipnirClient.csproj" />
    <ProjectReference Include="..\SleipnirRest\SleipnirRest.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\Sleipnir\Grpc\customer.proto" GrpcServices="Client" Link="Grpc\customer.proto" />
  </ItemGroup>

</Project>