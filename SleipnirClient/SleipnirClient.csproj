<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Sleipnir.Client</PackageId>
    <Description>Client library for Sleipnir RPC framework (REST, WebSocket, SignalR)</Description>
  </PropertyGroup>

  <!-- Project README as the package README (PackageReadmeFile via Directory.Build.props). -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MessagePack" Version="3.1.12" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.32" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="8.0.32" />
  </ItemGroup>

  <!-- JsonElement formatter + SleipnirResponse formatter compiled against the MessagePack
       version referenced here (3.1.x). Source shared with SleipnirHub (2.5.x transitive there).
       Proven in spikes/MpFormatterProbe/. -->
  <ItemGroup>
    <Compile Include="..\SleipnirCommon\MessagePack\JsonElementMessagePackFormatter.cs" Link="MessagePack\JsonElementMessagePackFormatter.cs" />
    <Compile Include="..\SleipnirCommon\MessagePack\JsonNodeMessagePackFormatter.cs" Link="MessagePack\JsonNodeMessagePackFormatter.cs" />
    <Compile Include="..\SleipnirCommon\MessagePack\SleipnirResponseMessagePackFormatter.cs" Link="MessagePack\SleipnirResponseMessagePackFormatter.cs" />
    <Compile Include="..\SleipnirCommon\MessagePack\SleipnirResponseOfTMessagePackFormatter.cs" Link="MessagePack\SleipnirResponseOfTMessagePackFormatter.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SleipnirCore\SleipnirCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SleipnirTests" />
  </ItemGroup>

</Project>
