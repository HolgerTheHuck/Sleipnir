<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Sleipnir.Client</PackageId>
    <Description>Client library for Sleipnir RPC framework (REST, WebSocket, SignalR)</Description>
  </PropertyGroup>

  <!-- Project README as the package README (PackageReadmeFile via Directory.Build.props). -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MessagePack" Version="3.1.8" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.28" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="8.0.28" />
  </ItemGroup>

  <!-- JsonElement-Formatter + SleipnirResponse-Formatter gegen die hier referenced
       MessagePack-Version (3.1.8). Source geteilt mit SleipnirHub (dort 2.5.x transitiv).
       Bewiesen in spikes/MpFormatterProbe/. -->
  <ItemGroup>
    <Compile Include="..\SleipnirCommon\MessagePack\JsonElementMessagePackFormatter.cs" Link="MessagePack\JsonElementMessagePackFormatter.cs" />
    <Compile Include="..\SleipnirCommon\MessagePack\JsonNodeMessagePackFormatter.cs" Link="MessagePack\JsonNodeMessagePackFormatter.cs" />
    <Compile Include="..\SleipnirCommon\MessagePack\SleipnirResponseMessagePackFormatter.cs" Link="MessagePack\SleipnirResponseMessagePackFormatter.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SleipnirCore\SleipnirCore.csproj" />
  </ItemGroup>

</Project>
