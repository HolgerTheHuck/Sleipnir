<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Sleipnir.Core</PackageId>
    <Description>Core RPC engine: invoker, discovery, dependency resolver, interceptors</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- Project README as the package README (PackageReadmeFile=README.md). -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JsonPath.Net" Version="2.1.1" />
    <PackageReference Include="MessagePack.Annotations" Version="3.1.8" />
    <PackageReference Include="Microsoft.AspNetCore.Authorization" Version="8.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SleipnirCommon\SleipnirCommon.csproj" />
  </ItemGroup>

  <!-- The transport-agnostic event core (SleipnirCore.Events) is internal; the in-tree
       transports (WebSocket, REST/SSE) and the test project consume it directly. External
       consumers go through the public transport surfaces, not these implementation types. -->
  <ItemGroup>
    <InternalsVisibleTo Include="SleipnirWebSocket" />
    <InternalsVisibleTo Include="SleipnirRest" />
    <InternalsVisibleTo Include="SleipnirTests" />
  </ItemGroup>

</Project>
