<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Sleipnir.Hub</PackageId>
    <Description>SignalR transport + AddSleipnir/UseSleipnir server integration for Sleipnir RPC framework</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <!-- Project README as the package README (PackageReadmeFile via Directory.Build.props). -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="8.0.32" />
    <!-- Floor: transitively, SignalR.Protocols.MessagePack 8.0.x would pull a vulnerable
         MessagePack 2.5.x (GHSA-hv8m, GHSA-qhrr, ...). The direct reference forces the patched
         2.5.x — standalone hosts without their own 3.x reference would otherwise load the
         vulnerable version. -->
    <PackageReference Include="MessagePack" Version="2.5.307" />
  </ItemGroup>

  <!-- JsonElement formatter + SleipnirResponse formatter compiled against the MessagePack
       version resolved here (2.5.x, transitive via SignalR.Protocols.MessagePack 8.0.x).
       Source shared with SleipnirClient (3.1.x there). -->
  <ItemGroup>
    <Compile Include="..\SleipnirCommon\MessagePack\JsonElementMessagePackFormatter.cs" Link="MessagePack\JsonElementMessagePackFormatter.cs" />
    <Compile Include="..\SleipnirCommon\MessagePack\JsonNodeMessagePackFormatter.cs" Link="MessagePack\JsonNodeMessagePackFormatter.cs" />
    <Compile Include="..\SleipnirCommon\MessagePack\SleipnirResponseMessagePackFormatter.cs" Link="MessagePack\SleipnirResponseMessagePackFormatter.cs" />
    <Compile Include="..\SleipnirCommon\MessagePack\SleipnirResponseOfTMessagePackFormatter.cs" Link="MessagePack\SleipnirResponseOfTMessagePackFormatter.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SleipnirCore\SleipnirCore.csproj" />
  </ItemGroup>

  <!-- The access_token query middleware (SleipnirHub.Auth) is internal; its query rewriting is
       unit-tested directly. -->
  <ItemGroup>
    <InternalsVisibleTo Include="SleipnirTests" />
  </ItemGroup>

</Project>
