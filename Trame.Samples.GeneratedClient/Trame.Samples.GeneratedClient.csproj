<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Trame.Samples.GeneratedClient</RootNamespace>
    <!-- This sample is the Slice-2 "in-compilation" proof: the Trame source generator runs
         during this project's build and emits TrameGenerated.cs from contract.trame.json, so a
         typed TrameGeneratedClient + the Story-01 diamond compile against the real TrameClient
         runtime. The sample is compile-time proof only — Main does not execute a live server. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- The runtime the generated stubs call into. -->
    <ProjectReference Include="..\TrameClient\TrameClient.csproj" />
    <!-- The generator, wired as an analyzer so it runs during this build. Dev wiring: in a
         published setup this is <PackageReference Include="Trame.Generator" PrivateAssets="all" />
         and the build/Trame.Generator.props auto-imports the AdditionalFile. -->
    <ProjectReference Include="..\Trame.SourceGenerator\Trame.SourceGenerator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Dev wiring: explicitly mark the contract as an AdditionalFile (the packaged
       build/Trame.Generator.props does this automatically when referenced as a NuGet). -->
  <ItemGroup>
    <AdditionalFiles Include="contract.trame.json" />
  </ItemGroup>

</Project>