<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0 (documented exception to the repo's net8.0-only rule): Roslyn source
         generators must target netstandard2.0 so they load inside the C# compiler host. The
         generator cannot reference the net8.0 TrameCore; it emits by compiling the Trame.Codegen.Core
         source directly into this assembly (see the Compile links below). -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PackageId>Trame.Generator</PackageId>
    <IsPackable>true</IsPackable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <DevelopmentDependency>true</DevelopmentDependency>
    <Description>Roslyn source generator that turns a committed Trame discovery contract (contract.trame.json) into a typed C# client at compile time. Interface drift builds the client against the current contract. Node-free, NuGet-shipped.</Description>
    <!-- IsRoslynComponent=true + IncludeBuildOutput=false → the SDK packs the generator
         assembly into analyzers/dotnet/cs/ rather than as a normal lib reference. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- Generator/analyzer project: enforce the extended analyzer rules (forbids compiler-internal
         APIs), and silence the analyzer release-tracking nag (RS2008) — our TRAME00x diagnostics are
         internal to Trame, not a versioned analyzer library. -->
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <NoWarn>RS2008;NU5128</NoWarn>
    <!-- Analyzer package: IncludeBuildOutput=false ships the assembly in analyzers/dotnet/cs/
         via a <None>, so the SDK's snupkg has no .pdb and nuget.org rejects it (400 "no symbol
         files"). Disable symbol packaging here — the 9 library packages still ship snupkgs. -->
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <!-- Expose the TryEmit diagnostic-mapping seam to the test project. The test references this
       project under an extern alias (the generator links Trame.Codegen.Core sources, which would
       otherwise collide with the standalone Trame.Codegen.Core reference); InternalsVisibleTo is
       by assembly name, so the alias does not interfere. -->
  <ItemGroup>
    <InternalsVisibleTo Include="TrameTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.8.0" PrivateAssets="all" />
    <!-- Trame.Codegen.Core is netstandard2.0 and self-contained (System.Text.Json only). We link
         its sources directly instead of ProjectReference-ing the assembly: the Roslyn analyzer
         load context resolves a generator's dependencies only from the generator assembly's own
         directory, and a ProjectReference-as-analyzer does not copy its deps there → a bare
         ProjectReference throws FileNotFoundException at generation time. Linking the sources
         makes the generator a single self-contained assembly. The standalone Trame.Codegen.Core
         project remains (it is the parity-gate + compile-gate target and is referenced by TrameTests);
         both compile the identical source. -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Trame.Codegen.Core\Casing.cs" Link="core\Casing.cs" />
    <Compile Include="..\Trame.Codegen.Core\Scalars.cs" Link="core\Scalars.cs" />
    <Compile Include="..\Trame.Codegen.Core\NamingResolver.cs" Link="core\NamingResolver.cs" />
    <Compile Include="..\Trame.Codegen.Core\Model.cs" Link="core\Model.cs" />
    <Compile Include="..\Trame.Codegen.Core\DiscoveryShape.cs" Link="core\DiscoveryShape.cs" />
    <Compile Include="..\Trame.Codegen.Core\EmitterInput.cs" Link="core\EmitterInput.cs" />
    <Compile Include="..\Trame.Codegen.Core\CsEmitter.cs" Link="core\CsEmitter.cs" />
    <Compile Include="..\Trame.Codegen.Core\TrameCodegen.cs" Link="core\TrameCodegen.cs" />
  </ItemGroup>

  <!-- Pack the build/ props into the nupkg so PackageReference auto-imports it (marks
       contract.trame.json as an AdditionalFile). -->
  <ItemGroup>
    <None Include="build\**\*" Pack="true" PackagePath="build\" />
    <None Include="README.md" Pack="true" PackagePath="README.md" />
    <None Include="..\CODEGEN_ONBOARDING.md" Pack="true" PackagePath="docs/CODEGEN_ONBOARDING.md" />
    <!-- Ship the generator assembly in analyzers/dotnet/cs/ so PackageReference loads it as a
         source generator. It is self-contained (Trame.Codegen.Core sources are linked in), so no
         dependency dlls need shipping; Microsoft.CodeAnalysis is provided by the compiler host. -->
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers\dotnet\cs\" />
  </ItemGroup>

</Project>