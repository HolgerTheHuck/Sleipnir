<?xml version="1.0" encoding="utf-8"?>
<Project>

  <!--
    Trame.Generator build props — auto-imported when this package is referenced.

    Marks the Trame discovery contract as an AdditionalFile so the Roslyn source generator
    (Trame.SourceGenerator) can read it at compile time and emit a typed C# client.

    Contract file selection (in priority order):
      1. $(TrameContractFile) — an explicit path (project-relative or absolute).
      2. contract.trame.json in the project directory (the default convention).

    Set TrameContractEnabled=false to disable the generator for a project (opt-out).

    The TrameContractFile property is surfaced to the generator via the build_property analyzer
    option so it can match the AdditionalFile by name (see TrameClientGenerator.Initialize).
  -->

  <PropertyGroup>
    <TrameContractFile Condition="'$(TrameContractFile)' == '' AND Exists('$(MSBuildProjectDirectory)\contract.trame.json')">contract.trame.json</TrameContractFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(TrameContractEnabled)' != 'false' AND '$(TrameContractFile)' != ''">
    <AdditionalFiles Include="$(TrameContractFile)" />
    <CompilerVisibleProperty Include="TrameContractFile" />
  </ItemGroup>

</Project>