<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Trame.Client</PackageId>
    <Description>Client library for Trame RPC framework (REST, WebSocket, SignalR)</Description>
  </PropertyGroup>

  <!-- Project README as the package README (PackageReadmeFile via Directory.Build.props). -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MessagePack" Version="3.1.8" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.28" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="8.0.28" />
  </ItemGroup>

  <!-- JsonElement-Formatter + TrameResponse-Formatter gegen die hier referenced
       MessagePack-Version (3.1.8). Source geteilt mit TrameHub (dort 2.5.x transitiv).
       Bewiesen in spikes/MpFormatterProbe/. -->
  <ItemGroup>
    <Compile Include="..\TrameCommon\MessagePack\JsonElementMessagePackFormatter.cs" Link="MessagePack\JsonElementMessagePackFormatter.cs" />
    <Compile Include="..\TrameCommon\MessagePack\JsonNodeMessagePackFormatter.cs" Link="MessagePack\JsonNodeMessagePackFormatter.cs" />
    <Compile Include="..\TrameCommon\MessagePack\TrameResponseMessagePackFormatter.cs" Link="MessagePack\TrameResponseMessagePackFormatter.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TrameCore\TrameCore.csproj" />
  </ItemGroup>

</Project>
