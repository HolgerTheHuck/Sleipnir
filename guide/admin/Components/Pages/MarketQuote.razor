@page "/quote"
@inject SleipnirGeneratedClient Sleipnir

<PageTitle>Market quote — Story.Admin</PageTitle>

<h1>Market quote</h1>

<p class="text-muted">
    The generated typed C# client calls <code>Market.GetQuote</code> on the Story.Api
    (chapter 2). The client, the <code>Quote</code> type, and the <code>Market.GetQuote</code>
    method are all <em>generated</em> from the server&rsquo;s <code>contract.sleipnir.json</code>.
</p>

<div class="row g-2 mb-3" style="max-width:32rem">
    <div class="col">
        <input @bind="symbol" class="form-control" placeholder="symbol, e.g. BTC" />
    </div>
    <div class="col-auto">
        <button class="btn btn-primary" @onclick="GetQuoteAsync" disabled="@busy">
            @(busy ? "Loading…" : "Get quote")
        </button>
    </div>
</div>

@if (error != null)
{
    <div class="alert alert-danger" style="max-width:32rem">@error</div>
}

@if (quote != null)
{
    <div class="card" style="max-width:32rem">
        <div class="card-body">
            <h5 class="card-title">@quote.Symbol</h5>
            <p class="card-text">
                Price: <strong>@quote.Price</strong><br />
                Change: <span class="@changeClass">@quote.Change</span><br />
                Time: @quote.Time?.ToLocalTime()
            </p>
        </div>
    </div>
}

@code {
    private string symbol = "BTC";
    // NOTE: the page class is named `MarketQuote` (the file name) deliberately — a page named
    // `Quote.razor` would shadow the generated `Sleipnir.Generated.Quote` type inside the file.
    private Quote? quote;
    private string? error;
    private bool busy;

    private string changeClass =>
        quote is null ? "" : (quote.Change > 0 ? "text-success" : quote.Change < 0 ? "text-danger" : "text-muted");

    private async Task GetQuoteAsync()
    {
        busy = true;
        error = null;
        quote = null;
        try
        {
            // client.Market.GetQuote(...) builds a typed Call; client.Call<Quote>(...) executes it.
            // "BTC" binds to the Arg<string> parameter (implicit conversion from a literal).
            var call = Sleipnir.Market.GetQuote(symbol);
            quote = await Sleipnir.Call<Quote>(call);
            if (quote is null) error = $"No market for symbol '{symbol}'.";
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }
}