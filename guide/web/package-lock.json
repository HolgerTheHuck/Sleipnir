{
  "name": "story-web",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "story-web",
      "version": "1.0.0",
      "dependencies": {
        "sleipnir-client": "file:../../clients/ts",
        "sleipnir-codegen": "file:../../clients/codegen"
      }
    },
    "../../clients/codegen": {
      "name": "sleipnir-codegen",
      "version": "1.3.1",
      "license": "MIT",
      "dependencies": {
        "sleipnir-client": "file:../ts"
      },
      "bin": {
        "sleipnir-gen": "dist/cli/index.js"
      },
      "devDependencies": {
        "@types/node": "^22.10.0",
        "typescript": "^5.6.3",
        "vitest": "^2.1.8"
      }
    },
    "../../clients/ts": {
      "name": "sleipnir-client",
      "version": "1.3.1",
      "license": "MIT",
      "devDependencies": {
        "@types/node": "^22.10.0",
        "@types/ws": "^8.5.13",
        "typescript": "^5.6.3",
        "vitest": "^2.1.8"
      },
      "optionalDependencies": {
        "ws": "^8.18.0"
      },
      "peerDependencies": {
        "@microsoft/signalr": ">=6.0.0"
      },
      "peerDependenciesMeta": {
        "@microsoft/signalr": {
          "optional": true
        }
      }
    },
    "node_modules/sleipnir-client": {
      "resolved": "../../clients/ts",
      "link": true
    },
    "node_modules/sleipnir-codegen": {
      "resolved": "../../clients/codegen",
      "link": true
    }
  }
