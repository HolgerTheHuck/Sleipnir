<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Sleipnir.Samples.CSharp</RootNamespace>
    <AssemblyName>Sleipnir.Samples.CSharp</AssemblyName>
  </PropertyGroup>

  <!-- Sleipnir.Client zieht transitiv Sleipnir.Core + Sleipnir.Common (REST, WebSocket,
       SignalR). Ein Paket genügt für alle Client-Szenarien. -->
  <ItemGroup>
    <PackageReference Include="Sleipnir.Client" Version="1.0.0" />
  </ItemGroup>

</Project>