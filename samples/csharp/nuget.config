<?xml version="1.0" encoding="utf-8"?>
<!-- Lokaler NuGet-Feed für die C#-Client-Samples: Sleipnir.Client aus dem lokalen
     artifacts/packages-Verzeichnis (dorthin per `dotnet pack -o artifacts/packages`). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="SleipnirLocal" value="../../artifacts/packages" />
  </packageSources>
</configuration>