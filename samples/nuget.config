<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Local feed for in-repo samples that consume the Sleipnir.* NuGet packages
       by PackageReference. Run `dotnet pack` of the shipped projects to
       ../artifacts/packages before building these samples against unpublished
       versions. After nuget.org publish this feed is a harmless fallback. -->
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="SleipnirLocal" value="../artifacts/packages" />
  </packageSources>
</configuration>