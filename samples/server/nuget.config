<?xml version="1.0" encoding="utf-8"?>
<!-- Lokaler NuGet-Feed für die Sample-Server: löst Trame.* aus dem lokalen
     artifacts/packages-Verzeichnis auf (dorthin werden die Pakete per
     `dotnet pack -o artifacts/packages` abgelegt). NuGet.org bleibt als
     Fallback für Drittabhängigkeiten aktiv. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="TrameLocal" value="../../artifacts/packages" />
  </packageSources>
</configuration>