{
  "name": "sleipnir-samples-typescript",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Runnable TypeScript client samples for the Sleipnir RPC framework.",
  "scripts": {
    "start": "node --experimental-strip-types run.ts",
    "start:1": "node --experimental-strip-types run.ts 1",
    "start:2": "node --experimental-strip-types run.ts 2",
    "start:3": "node --experimental-strip-types run.ts 3",
    "start:4": "node --experimental-strip-types run.ts 4",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "sleipnir-client": "file:../../clients/ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.6.3",
    "ws": "^8.18.0"
  }
}