{
  "name": "story01-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Story 01 demo UI — consumes the trame-codegen-generated typed client. The N+1 screen: 6 serial roundtrips vs 1 typed Trame batch.",
  "scripts": {
    "setup": "npm run build --prefix ../../clients/codegen",
    "gen": "node scripts/gen.mjs",
    "dev": "npm run gen && vite",
    "build": "npm run gen && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "trame-client": "file:../../../clients/ts",
    "trame-codegen": "file:../../../clients/codegen"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "~5.6.3",
    "vite": "^6.0.0"
  }
}